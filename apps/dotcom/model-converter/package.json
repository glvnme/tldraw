{
	"name": "@tldraw/model-converter",
	"description": "Local service that converts uploaded 3D models to optimized GLB.",
	"version": "0.0.0",
	"private": true,
	"author": {
		"name": "tldraw GB Ltd.",
		"email": "hello@tldraw.com"
	},
	"type": "module",
	"scripts": {
		"dev": "pnpm exec tsx src/server.ts",
		"convert": "pnpm exec tsx src/cli.ts",
		"test": "pnpm exec vitest --passWithNoTests",
		"test-ci": "pnpm exec vitest run --passWithNoTests",
		"test-coverage": "pnpm exec vitest run --coverage --passWithNoTests",
		"lint": "pnpm exec tsx ../../../internal/scripts/lint.ts",
		"build-types": "tsc --build"
	},
	"dependencies": {
		"earcut": "3.0.2",
		"gltfpack": "1.3.0",
		"rhino3dm": "8.35.0",
		"web-ifc": "0.0.78"
	},
	"devDependencies": {
		"@tldraw/dotcom-shared": "workspace:*",
		"vitest": "^5.0.0"
	}
}
